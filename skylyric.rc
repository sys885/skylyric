#include <windows.h>

#pragma code_page(65001)

#define IDI_APP 1

IDI_APP ICON "skylyric.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      ""
            VALUE "FileDescription",  "天际屏歌词"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "skylyric"
            VALUE "LegalCopyright",   ""
            VALUE "OriginalFilename", "skylyric.exe"
            VALUE "ProductName",      "天际屏歌词"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 0x04b0
    END
END
